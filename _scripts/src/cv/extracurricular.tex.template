\cvsection{{% emit(website['sections']['extracurricular']) %}}
\begin{cvoneliners}
{%
  for i in (data['extracurricular']['content']):
    if i.get('hide') or i.get('cv_hide'): continue
    emit_tex('\\cvoneliner ')
    emit_braces(i['title'] + ", " + i['location'])
    emit_braces(i['about'])
    emit_braces(i['duration'])
%}
\end{cvoneliners}
