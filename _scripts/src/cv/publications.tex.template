\cvsection{ {% emit(website['sections']['publications']) %} }

{%
types = [
          'journal',
          'conference',
          'papers-in-review',
          'papers-in-preparation',
          'other-publications',
          'thesis',
          'abstracts',
          'posters',
        ]

nb = 1
for type in types:
  if not 'papers' in publications[type]: continue
  if len(publications[type]['papers']) <= 0: continue

  emit_tex('\\cvsubsection')
  emit_braces(website['sections'][type])

  emit_tex('\\begin{cvpapers}')
  emit('\n')
  for i in publications[type]['papers']:
    if i.get('hide') or i.get('cv_hide'): continue
    emit_tex('\\cvpaper ')
    emit('\n')
    if "*" in i['authors']:
        emit_tex('{'+i['authors'].replace(website['cv']['author'], '\\textbf{'+website['cv']['author']+'}')+' (* co-first author)}')
    else:
        emit_tex('{'+i['authors'].replace(website['cv']['author'], '\\textbf{'+website['cv']['author']+'}')+'}')
    emit('\n')

    if 'url' in i and i['url'] != None:
      url = i['url']
      if url.startswith('/'): url = website['cv']['website'] + url
      emit_braces(url)
      emit('\n')
    else:
      emit_braces('')
      emit('\n')

    emit_braces(i['title'])
    emit('\n')

    if type == 'papers-in-preparation':
      venue = i.get('book') or 'In preparation'
    else:
      venue = i['book'].strip().rstrip('.')
      if str(i['pub_date']) not in venue: venue += ', ' + str(i['pub_date'])
    emit_braces(venue)
    emit('\n')

    emit_braces("[" + str(nb) + "]")
    emit('\n')
    emit('\n')
    nb = nb + 1
  emit('\n')
  emit_tex('\\end{cvpapers}')
%}

\cvsection{ {% emit(website['cv']['secondary-title']) %} }

{%

types = [ 
    'students',
    'news'
]
for type in types:
    nb = 1
    emit_tex('\\cvsubsection')
    emit_braces(website['sections'][type])

    emit_tex('\\begin{cvnews}')
    emit('\n')
    for i in data[type]['content']:
        if i.get('hide') or i.get('cv_hide'): continue
        emit_tex('\\cvnew ')
        emit('\n')
        emit_braces(i['title'])
        emit('\n')

        emit_braces('')
        emit('\n')

        emit_braces(i['location'])
        emit('\n')

        emit_braces(i['duration'])
        emit('\n')

        emit_braces("[" + str(nb) + "]")
        emit('\n')
        emit('\n')
        nb = nb + 1
    emit('\n')
    emit_tex('\\end{cvnews}')

%}
