\cvsection{ {% emit(data['awards']['title']) %} }
\begin{cvhonors}
{%
  for i in (data['awards']['content']):
    if 'hide' in i and i['hide'] == True: continue
    emit_tex('\\cvhonor ')
    emit_braces(i['award'])
    emit_braces(i['event'])
    emit_braces(i['location'])
    emit_braces(to_date(i['date']))
%}
\end{cvhonors}
