% A4 paper size by default, use 'letterpaper' for US letter
\documentclass[11pt, a4paper]{awesome-cv}

\usepackage{xcolor}
\usepackage{etoolbox}

% Configure page margins with geometry
\geometry{left=1.4cm, top=.8cm, right=1.4cm, bottom=1.8cm, footskip=.5cm}

% Color for highlights
% Awesome Colors: awesome-emerald, awesome-skyblue, awesome-red, awesome-pink, awesome-orange
%                 awesome-nephritis, awesome-concrete, awesome-darknight
\colorlet{awesome}{awesome-red}
% Uncomment if you would like to specify your own color
% \definecolor{awesome}{HTML}{CA63A8}

% Colors for text
% Uncomment if you would like to specify your own color
% \definecolor{darktext}{HTML}{414141}
% \definecolor{text}{HTML}{333333}
% \definecolor{graytext}{HTML}{5D5D5D}
% \definecolor{lighttext}{HTML}{999999}
\definecolor{link}{HTML}{B509AC}

% Set false if you don't want to highlight section with awesome color
\setbool{acvSectionColorHighlight}{true}

% If you would like to change the social information separator from a pipe (|) to something else
\renewcommand{\acvHeaderSocialSep}{\quad\textbar\quad}

%-------------------------------------------------------------------------------
%	PERSONAL INFORMATION
%-------------------------------------------------------------------------------

% Available options: circle|rectangle,edge/noedge,left/right
\photo[circle,edge,left]{{% emit(data['personal']['photo_loc']+website['cv']['portrait_url']) %}}

\name{{% emit(data['personal']['first-name']) %}}{{% emit(data['personal']['last-name']) %}}
\position{
{% 
nb = len(website['cv']['titles'])
for title in website['cv']['titles']:
  emit(title)
  nb = nb - 1
  if nb > 0:
    emit_tex('{\\enskip\\cdotp\\enskip}')
%}
}

\email{{% emit(data['personal']['links']['email']) %}}
\googlescholar{{% emit(data['personal']['links']['googlescholar']) %}}{Scholar}
\linkedin{{% emit(data['personal']['links']['linkedin']) %}}
\github{{% emit(data['personal']['links']['github']) %}}
\homepage{{% emit(data['personal']['links']['homepage']) %}}
\orcid{{% emit(data['personal']['links']['orcid']) %}}

%-------------------------------------------------------------------------------
\begin{document}

% Print the header with above personal informations
% Give optional argument to change alignment(C: center, L: left, R: right)
\makecvheader[C]

% Print the footer with 3 arguments(<left>, <center>, <right>)
% Leave any of these blank if they are not needed
\makecvfooter
  {} % \today
  { {% emit(data['personal']['first-name']+" "+data['personal']['last-name']) %}~~~|~~~Curriculum Vitae}
  {} % \thepage
 
{%
  line = website['cv'].get('research_line')
  if line:
    numbered = []
    nb = 1
    for group in ['journal', 'conference', 'papers-in-review']:
      for paper in publications[group]['papers']:
        if paper.get('hide') or paper.get('cv_hide'): continue
        numbered.append((nb, group, paper.get('program') or []))
        nb = nb + 1

    def spans(numbers):
      out = []
      for n in numbers:
        if out and out[-1][1] == n - 1: out[-1][1] = n
        else: out.append([n, n])
      return ', '.join(str(a) if a == b else str(a) + '-' + str(b) for a, b in out)

    emit_tex('\\cvsection{')
    emit(line['title'])
    emit_tex('}\n\\par\\noindent\\descriptionstyle{')
    emit(line['summary'])
    emit_tex('}\n\\begin{cvitems}\n')
    for part in line['parts']:
      hits = [row for row in numbered if set(row[2]) & set(part['programs'])]
      published = [row[0] for row in hits if row[1] != 'papers-in-review']
      review = [row[0] for row in hits if row[1] == 'papers-in-review']
      emit_tex('\\item \\descriptionstyle{\\textbf{')
      emit(part['label'])
      emit_tex('}: ')
      emit('published [' + spans(published) + '], in review [' + spans(review) + ']')
      emit_tex('}\n')
    emit_tex('\\end{cvitems}\n')
%}
\input{cv/experience.tex}
\cvsection{{% emit(website['sections']['academic']) %}}
\begin{cvoneliners}
{%
  for i in (data['academic']['content']):
    if i.get('hide') or i.get('cv_hide'): continue
    emit_tex('\\cvoneliner ')
    emit_braces(i['title'])
    emit_braces(i['location'])
    emit_braces(i['duration'])
%}
\end{cvoneliners}
{%
  service = [i for i in data.get('service', {}).get('content', []) if not i.get('hide') and not i.get('cv_hide')]
  if service:
    emit_tex('\\filbreak\n\\cvsection{')
    emit(website['sections']['service'])
    emit_tex('}\n\\begin{cvoneliners}\n')
    for i in service:
      emit_tex('\\cvoneliner ')
      emit_braces(i['title'])
      emit_braces(i.get('location', ''))
      emit_braces(i.get('duration', ''))
    emit_tex('\\end{cvoneliners}\n')
%}
\input{cv/education.tex}
\input{cv/grants.tex}
\input{cv/projects.tex}
\input{cv/honors.tex}
\input{cv/extracurricular.tex}
\newpage
{% check_minimal("\\input{cv/publications.tex}") %}

\cvsection{{% emit(website['sections']['references']) %}}
\begin{cvoneliners}
{%
  for i in (data['references']['content']):
    if i.get('hide') or i.get('cv_hide'): continue
    emit_tex('\\cvoneliner ')
    emit_braces(i['name'])
    emit_braces(i['email'])
    emit_braces(i['reason'])
%}
\end{cvoneliners}

%-------------------------------------------------------------------------------
\end{document}